{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mutable community feedback 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "feedback": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_url",
          "ok",
          "ng"
        ],
        "properties": {
          "issue_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
          },
          "ok": {
            "type": "integer",
            "minimum": 0
          },
          "ng": {
            "type": "integer",
            "minimum": 0
          },
          "refreshed_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "format": "date-time"
          }
        }
      }
    }
  }
}
